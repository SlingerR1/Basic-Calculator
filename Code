# include <iostream>
#include <cmath>

using namespace std;

int main(){

    string operation;
    double number1, number2, result;
    cout << "Enter the first number: ";
    cin >> number1;
    cout << "Enter the second number: ";
    cin >> number2;
    cout << "Enter the operation (+, -, *, /): ";
    cin >> operation;

    if (operation == "+") {
        result = number1 + number2;
    } else if (operation == "-") {
        result = number1 - number2;
    } else if (operation == "*") {
        result = number1 * number2;
    } else if (operation == "/") {
        result = number1 / number2;
    }

    cout << "The result is: " << result << endl;

    return 0;
}
